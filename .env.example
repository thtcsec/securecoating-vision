VOLCENGINE_TOKEN=your_api_token
PARATERA_API_KEY=
SCNET_USERNAME=

# Local demo mode (never use these settings for a production PLC)
SECURECOATING_ENV=development
SECURECOATING_ALLOW_UNAUTHENTICATED_DEMO=true
SECURECOATING_ENABLE_SENSOR_SIMULATION=true

# Production requires real values from a secret manager and verified OT config.
# SECURECOATING_ENV=production
# SECURECOATING_API_KEY=<secret>
# SECURECOATING_FACTORY_SECRET=<secret>
# SECURECOATING_INDUSTRIAL_MOCK_MODE=false
# SECURECOATING_ALLOWED_ORIGINS=http://127.0.0.1:8501