# Hugging Face tokens for gated assets (never commit real values).
# Used by:
#   - Evenrose/LIBAD dataset download (scripts/download_libad.py)
#   - Authors' DINOv3 ConvNeXt weights for scripts/run_libad_official_baseline.py
# Accept model terms on each facebook/dinov3-convnext-* page before the runner can download.
# Prefer a READ token. HF_TOKEN is the primary key; HUGGING_FACE_HUB_TOKEN is also accepted.
HF_TOKEN=
# HUGGING_FACE_HUB_TOKEN=

VOLCENGINE_TOKEN=your_api_token
PARATERA_API_KEY=
SCNET_USERNAME=

# Local demo mode (never use these settings for a production PLC)
SECURECOATING_ENV=development
SECURECOATING_ALLOW_UNAUTHENTICATED_DEMO=true
SECURECOATING_ENABLE_SENSOR_SIMULATION=true
SECURECOATING_HARDWARE_PROFILE=auto

# Localhost Modbus software loopback via scripts/run_modbus_loopback_trigger.py
# Not vendor PLC HIL. Do not point this at a plant network.
# SECURECOATING_INDUSTRIAL_MOCK_MODE=false
# SECURECOATING_COMMAND_CHANNEL=modbus
# SECURECOATING_PLC_IP=127.0.0.1
# SECURECOATING_MODBUS_PORT=1502
# SECURECOATING_MODBUS_TRUSTED_GATEWAY=true
# SECURECOATING_INDUSTRIAL_EVIDENCE_CLASS=software_loopback_not_vendor_hil

# Production requires real values from a secret manager and verified OT config.
# SECURECOATING_ENV=production
# Both secrets must be at least 32 bytes; generate them in a secret manager.
# SECURECOATING_API_KEY=<32-or-more-random-bytes>
# SECURECOATING_FACTORY_SECRET=<32-or-more-random-bytes>
# SECURECOATING_OPERATOR_CREDENTIALS=[{"operator_id":"OP_SHIFT_A","token_sha256":"<sha256>","roles":["operator"]}]
# SECURECOATING_INDUSTRIAL_MOCK_MODE=false
# SECURECOATING_ALLOWED_ORIGINS=http://127.0.0.1:8501
# SECURECOATING_TRUSTED_HOSTS=localhost,127.0.0.1,api
# SECURECOATING_HARDWARE_PROFILE=auto
# SECURECOATING_MAX_UPLOAD_BYTES=10485760
# SECURECOATING_MAX_IMAGE_PIXELS=8000000
# SECURECOATING_MAX_INFLIGHT_INSPECTIONS=1
